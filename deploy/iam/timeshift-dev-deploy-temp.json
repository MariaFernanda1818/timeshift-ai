{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyTimeshiftStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:ACCOUNT_ID:stack/timeshift*/*"
    },
    {
      "Sid": "StacksMustUseTheProjectServiceRole",
      "Effect": "Deny",
      "Action": ["cloudformation:CreateStack", "cloudformation:UpdateStack"],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {"cloudformation:RoleArn": "arn:aws:iam::ACCOUNT_ID:role/timeshift-cfn-role"}
      }
    },
    {
      "Sid": "PassOnlyTheCfnServiceRoleToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/timeshift-cfn-role",
      "Condition": {"StringEquals": {"iam:PassedToService": "cloudformation.amazonaws.com"}}
    },
    {
      "Sid": "PortForwardToProjectInstancesOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/project": "timeshift-hackathon"}}
    },
    {
      "Sid": "PortForwardingDocumentOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSession"
    },
    {
      "Sid": "OwnSessionsOnly",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession"],
      "Resource": "arn:aws:ssm:us-east-1:ACCOUNT_ID:session/${aws:username}-*"
    }
  ]
}
