# Copy to .env (never commit .env). No secrets are required in this file:
# AWS credentials come from your AWS profile / SSO / instance role.
AWS_REGION=us-east-1
# AWS_PROFILE=timeshift
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1500
# Same or different model for the benchmark's LLM-judge baseline (config B)
JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Strands Decider 2B server (strands-decider serve ... --port 8099). Keep it private.
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_EXPECTED_CHECKPOINT=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
DECIDER_TIMEOUT_S=600
# STRANDS_DECIDER_TOKEN=   # only if an authenticating proxy fronts the server

# Optional: send only Decider's REVIEW band to the Bedrock judge (never replaces a failed Decider)
# TIMESHIFT_ESCALATION=bedrock
# DECIDER_PROCEED_AT=0.90   # value chosen on the calibration split
